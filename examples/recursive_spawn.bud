// My eyes only! Sorry but ignore this eyesore, more for testing

def worker(Integer n) -> String:
    let id = receive()
    if(n == 0):
        send("leaf " + id + " ready")
        return id
    let h1 = spawn worker(n - 1)
    let h2 = spawn worker(n - 1)
    let h3 = spawn worker(n - 1)
    h1.send(id + ".1")
    h2.send(id + ".2")
    h3.send(id + ".3")
    let m1 = h1.receive()
    let m2 = h2.receive()
    let m3 = h3.receive()
    send("node " + id + " got: [" + m1 + ", " + m2 + ", " + m3 + "]")
    let r1 = await h1
    let r2 = await h2
    let r3 = await h3
    return "[" + r1 + " " + r2 + " " + r3 + "]"

let h1 = spawn worker(2)
let h2 = spawn worker(2)
let h3 = spawn worker(2)

h1.send("A")
h2.send("B")
h3.send("C")

print(h1.receive())
print(h2.receive())
print(h3.receive())

print(await h1)
print(await h2)
print(await h3)

