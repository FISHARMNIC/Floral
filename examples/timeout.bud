shared String s = "INITIAL"

def worker() -> Integer:
    sleep_ms(100)
    s = "CHANGED"
    return 42

let result = timeout(spawn worker(), 50)

print("Timeout? ${result.fail}")
print("STRING IS: ${s}, RETURN IS: ${result.res}")

result = timeout(spawn worker(), 200)

print("Timeout? ${result.fail}")
print("SHARED IS: ${s}, RETURN IS: ${result.res}")

/*
@@@EXPECTS@@@
Timeout? true
STRING IS: INITIAL, RETURN IS: 0
Timeout? false
SHARED IS: CHANGED, RETURN IS: 42
@@@END@@@
*/