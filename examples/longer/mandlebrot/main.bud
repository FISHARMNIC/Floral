import "lib" as render

const num_workers = 40
const out_width = 1000
const out_height = 1000

// default
// const iters = 255
// const start_re = -2.0
// const start_im = -1.5
// const width_re = 3.0
// const height_im = 3.0

// seahorse valley
// const iters = 1000
// const start_re = -0.79
// const start_im = -0.1374
// const width_re = 0.02
// const height_im = 0.02

// elephant valley
const iters = 600
const start_re = 0.28
const start_im = 0.005
const width_re = 0.02
const height_im = 0.02

// double spiral
// const iters = 1000
// const start_re = -0.7269
// const start_im = 0.1889
// const width_re = 0.005
// const height_im = 0.005

// cool
// const iters = 2000
// const start_re = -0.7479915
// const start_im = 0.100631
// const width_re = 0.000017
// const height_im = 0.000017



let List<Byte> pixels
pixels.resize(out_width * out_height * 3)

shared fullImage = ImageFrame{pixels: pixels, width: out_width, height: out_height}

def compute_point(Float x, Float y) -> Int:
    const start = complex(x, y)
    let z = complex(0.0, 0.0)
    repeat(i, iters):
        z = z * z + start
        const re = z.real()
        const im = z.imag()
        if((re * re + im * im) > 4):
            return i
    return 255

const sx = width_re/out_width
const sy = height_im/out_height

shared Int dc = 0
def computer(Int start_y, Int height):
    const fin = start_y + height
    let draw_y = start_y
    let compute_y = draw_y * sy + start_im
    while(draw_y < fin):   
        let draw_x = 0
        let compute_x = start_re
        while(draw_x < out_width):
            const res = compute_point(compute_x, compute_y)
            render.drawPixel(fullImage, draw_x, draw_y, Color{red: res.toByte(), green: res.toByte(), blue: res.toByte()})
            // render.drawPixel(fullImage, draw_x, draw_y, Color{red: ((res % 32) * 8).toByte(), green: ((res % 64) * 4).toByte(), blue: ((res % 128) * 2).toByte()})
            compute_x = compute_x + sx
            draw_x = draw_x + 1
        compute_y = compute_y + sy
        draw_y = draw_y + 1
    dc = dc + 1


const worker_height = out_height / num_workers
let List<Handler<None>> workers

repeat(i, num_workers):
    workers.push(spawn computer(worker_height * i, worker_height))

repeat(i, num_workers):
    await workers[i]
    // if want to see live
    // render.createImage(fullImage)

// workers.forEach(lambda(Handler<None> x)-> None: print("hi")) @todo fails

render.createImage(fullImage)