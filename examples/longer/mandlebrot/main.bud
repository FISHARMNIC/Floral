/*
Mandlebrot in Floral!
Nicolas Quijano 2026

Requires SDL2

!! Please run with the provided shell script "run.sh", note that you probably have to modify it to link SDL2 on your system

Navigation:
    Keyboard:
        WASD = move
        +/-  = zoom
        [/]  = iterations
    Trackpad:
        Scroll = move
        Pinch = zoom
        Automatic iterations

Runs pretty smooth on my macbook air - no lag
*/

import "lib" as sdl

// @todo move out once import vars fixed
cppIdentifier(Int, "SDL_QUIT")
cppIdentifier(Int, "SDL_KEYDOWN")
cppIdentifier(Int, "SDL_MOUSEWHEEL")
cppIdentifier(Int, "SDL_MULTIGESTURE")

cppIdentifier(Int, "SDLK_ESCAPE")
cppIdentifier(Int, "SDLK_w")
cppIdentifier(Int, "SDLK_a")
cppIdentifier(Int, "SDLK_s")
cppIdentifier(Int, "SDLK_d")
cppIdentifier(Int, "SDLK_EQUALS")
cppIdentifier(Int, "SDLK_MINUS")
cppIdentifier(Int, "SDLK_LEFTBRACKET")
cppIdentifier(Int, "SDLK_RIGHTBRACKET")

// start options
restricted iters = 50
restricted start_re = -2.0
restricted start_im = -1.5
restricted zoom = 3.0

// render size
const out_width = 512
const out_height = 512
const center_x = out_width / 2
const center_y = out_height / 2

// workers
const num_workers = 16
const worker_height = out_height / num_workers
const List<Handler<None>> workers
workers.resize(num_workers)

// buffer
let List<Byte> pixels
pixels.resize(out_width * out_height * 3)
shared fullImage = ImageFrame{pixels: pixels, width: out_width, height: out_height}

// see if single point is in fractal
def compute_point(Float x, Float y) -> Int:
    const start = complex(x, y)
    let z = complex(0.0 , 0.0)
    repeat(i, iters):
        // for mandlebrot
        z = z * z + start
        // for burning ship
        // const ship = complex(math.abs(z.real()), math.abs(z.imag()))
        // z = ship * ship + start
        
        const re = z.real()
        const im = z.imag()
        if((re * re + im * im) > 4):
            return i
    return 255

// compute region
def computer(Int start_y, Int height, Float start_im, Float sx, Float sy):
    const fin = start_y + height
    let draw_y = start_y
    let compute_y = draw_y * sy + start_im
    while(draw_y < fin):   
        let draw_x = 0
        let compute_x = start_re
        while(draw_x < out_width):
            const res = compute_point(compute_x, compute_y)
            // sdl.drawPixel(fullImage, draw_x, draw_y, Color{red: res.toByte(), green: res.toByte(), blue: res.toByte()})
            // @todo not as fast as it could be - mutexed
            sdl.drawPixel(fullImage, draw_x, draw_y, Color{red: ((res % 32) * 8).toByte(), green: ((res % 64) * 4).toByte(), blue: ((res % 128) * 2).toByte()})
            compute_x = compute_x + sx
            draw_x = draw_x + 1
        compute_y = compute_y + sy
        draw_y = draw_y + 1

// tell all workers to compute regions
// @todo use message passing a keep workers alive
def draw():
    const sx = zoom/out_width
    const sy = zoom/out_height
    repeat(i, num_workers):
        workers[i] = spawn computer(worker_height * i, worker_height, start_im, sx, sy)
    repeat(i, num_workers):
        await workers[i]
    repeat(i, 10):
        sdl.drawPixel(fullImage, center_x + i - 5, center_y, Color{red: 0, green: 0, blue: 0})
        sdl.drawPixel(fullImage, center_x, center_y + i - 5, Color{red: 0, green: 0, blue: 0})
    sdl.render(fullImage)
    print("Z = (${start_re} + ${start_im}i), View Size = ${zoom}, Iterations = ${iters}")

// main
sdl.setup(fullImage)
draw()
let running = true
let disablePinch = 0
while(running):
    while(sdl.pollEvent()):
        if(sdl.eventIs(SDL_MOUSEWHEEL)):
            const x = sdl.mouseScrollX()
            const y = sdl.mouseScrollY()
            const step = 0.05 * zoom
            start_re = start_re + (step * x)
            start_im = start_im - (step * y)
            disablePinch = 20
            draw()
        elif(sdl.eventIs(SDL_QUIT)):
            sdl.stop()
            running = false
        elif(sdl.eventIs(SDL_KEYDOWN)):
            const step = 0.1 * zoom
            if(sdl.keyIs(SDLK_a)):
                start_re = start_re - step
            if(sdl.keyIs(SDLK_d)):
                start_re = start_re + step
            if(sdl.keyIs(SDLK_w)):
                start_im = start_im - step
            if(sdl.keyIs(SDLK_s)):
                start_im = start_im + step
            if(sdl.keyIs(SDLK_EQUALS)):
                zoom = zoom * 0.90
                start_re = start_re + (step/2)
                start_im = start_im + (step/2)
            if(sdl.keyIs(SDLK_MINUS)):
                zoom = zoom / 0.90
                start_re = start_re - (step/2)
                start_im = start_im - (step/2)
            if(sdl.keyIs(SDLK_LEFTBRACKET)):
                iters = iters - 3
            if(sdl.keyIs(SDLK_RIGHTBRACKET)):
                iters = iters + 3
            draw()
        elif(sdl.eventIs(SDL_MULTIGESTURE) && disablePinch == 0):
            const pinch = sdl.mousePinch() * 100
            const step = 0.2 * zoom
            if(pinch > 1.0):
                zoom = zoom * 0.8
                start_re = start_re + (step/2)
                start_im = start_im + (step/2)
                iters = iters + 7
                draw()
            elif(pinch < -1.0):
                zoom = zoom / 0.8
                start_re = start_re - (step/2)
                start_im = start_im - (step/2)
                iters = iters - 7
                draw()
    if(disablePinch > 0):
        disablePinch = disablePinch - 1