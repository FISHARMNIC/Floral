import "lib" as render

const out_width = 400
const out_height = 400

let List<Byte> pixels
pixels.resize(out_width * out_height * 3)

const fullImage = ImageFrame{pixels: pixels, width: out_width, height: out_height}

render.drawPixel(fullImage, 200, 200, Color{red: 255, green: 255, blue: 255})
render.createImage(fullImage)