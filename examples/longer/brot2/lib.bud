cppInclude("./funcs.cpp") // Ewww!

cppIdentifier(Int, "SDL_QUIT")
cppIdentifier(Int, "SDL_KEYDOWN")

cppIdentifier(Int, "SDLK_ESCAPE")
cppIdentifier(Int, "SDLK_LEFT")
cppIdentifier(Int, "SDLK_RIGHT")
cppIdentifier(Int, "SDLK_UP")
cppIdentifier(Int, "SDLK_DOWN")

export type Color = {Byte red, Byte green, Byte blue}
export type ImageFrame = {List<Byte> pixels, Int width, Int height}

export def setup(shared ImageFrame frame):
    cppCall(None, "cpp_sdl_setup", frame.width, frame.height)

export def render(shared ImageFrame frame):
    cppCall(None, "cpp_sdl_render", frame.pixels._dataptr(), frame.width, frame.height)

export def stop:
    cppCall(None, "cpp_sdl_stop")

// export def loop:
//     cppCall(None, "cpp_sdl_loop")

export def pollEvent -> Bool:
    return cpp(Bool, "SDL_PollEvent(&event)")

export def eventIs(Int s) -> Bool:
    return cpp(Bool, "(event.type == s)") // @todo will break if ever obfuscate user vars/args/funcs/etc

export def keyIs(Int s) -> Bool:
    return cpp(Bool, "(event.key.keysym.sym == s)") // @todo will break if ever obfuscate user vars/args/funcs/etc

export def drawPixel(shared ImageFrame image, Int x, Int y, const Color col):
    image.pixels[(y * image.width + x) * 3 + 0] = col.red
    image.pixels[(y * image.width + x) * 3 + 1] = col.green
    image.pixels[(y * image.width + x) * 3 + 2] = col.blue

