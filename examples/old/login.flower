function login:
    let page = await puppet:open("login.com")
    let rec = recieve()
    puppet:enter("#username", username)
    puppet:enter("#password", password)
    puppet:click("#login")
end 


let handler = spawn login()
let username = await io:prompt("Username: ")
let password = await io:prompt("Password: ")

handler.send()

await handler

print("Done!")