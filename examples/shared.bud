// $ indicates a variable whos reference is shared across threads
def myChild(shared String sharedVar, Int normalVar) -> String:
    print(normalVar, sharedVar)
    send()
    receive()
    print(normalVar, sharedVar)
    return "All done!"

let someNormal = 123
shared someShared = "apples" // declare shared like this

let child1 = spawn myChild(someShared, someNormal)

child1.receive()        // block until child calls send()
someNormal = 456        // wont be updated across the threads
someShared = "oranges"  // is updated in myChild
child1.send()

let res = await child1
print(res)

// runs like normal function, send and receive do nothing
let res2 = myChild(someShared, someNormal)
print(res2)

/*
@@@EXPECTS@@@
123 apples
123 oranges
All done!
456 oranges
456 oranges
All done!
@@@END@@@
*/