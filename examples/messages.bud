function myChild -> None:
    send("Knock Knock")
    while(true):
        let recv = receive()
        print(recv)
        if(recv == "Who is there?"):
            send("Your child!")
        elif(recv == "Oh hi!"):
            send("Wassup")
            break

let child = spawn myChild()

while(true):
    let recv = child.receive()
    print(recv)
    if(recv == "Knock Knock"):
        child.send("Who is there?")
    elif(recv == "Your child!"):
        child.send("Oh hi!")
    elif(recv == "Wassup"):
        break

await child