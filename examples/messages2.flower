function myChild(Integer number) -> String:
    send()
    print(number)
    receive()
    print(number)
    return "All done!"
end

let someNumber = 111

let child1 = spawn myChild(someNumber)

child1.receive()
someNumber = 222
child1.send()
let res = await child1
print(res)

// runs like normal function, send and receive do nothing
let res2 = myChild(someNumber)
print(res)