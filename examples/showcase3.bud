def calculator(String name, List<String> expenses, shared Int total) -> Int:
    // perform some calculations
    let nums    = expenses.map(lambda(String s) -> Int: s.toInteger())
    let sum     = nums.reduce(lambda(Int acc, Int x) -> Int: acc + x)
    total       = total + sum
    // send a status update to our parent
    send("About to do some more work...")
    sleep_ms(50) // simulate some heavy job
    print("Worker", name, "is done!")
    // return this persons contribution
    return sum

// shared variables work how they sound
shared household = 0
let a = spawn calculator("Nico", ["100", "20", "35"],  household)
let b = spawn calculator("Rio",  ["15",  "150", "25"], household)

// main does real work while threads run
print("waiting for notifications...")
print("from a:", a.receive())
print("from b:", b.receive())

// wait for threads to finish
let ra = await a
let rb = await b

print("Nico:", ra, "| Rio:", rb, "| Total:", household)
