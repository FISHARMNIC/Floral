// declare a basic struct
type Report = {String name, List<String> expenses}

// shared variables maintain reference across threads
def calculator(const Report report, shared Int total) -> Int:
    // perform some calculations
    let nums    = report.expenses.map(toInteger) 
    let sum     = nums.reduce(lambda(Int acc, Int x) -> Int: acc + x)
    total       = total + sum
    // send a status update to our parent
    send("About to do some more work...")
    sleep_ms(50) // simulate some heavy job
    print("Worker", report.name, "is done!")
    // return this persons contribution
    return sum
 
// Run calculator on two new threads and get a handle to them
shared household = 0
let a = spawn calculator(Report{name: "Nico", expenses: ["100", "20",  "35"]}, household)
let b = spawn calculator(Report{name: "Rio",  expenses: ["15",  "150", "25"]}, household)

// to instead run on the active thread (like a normal function), just call it
// : let res = calculator(Report{name: "Mila",  expenses: ["40",  "50", "105"]}, household)
// : print("Mila:", res)
// (send() and receive() will be noops)

// main does real work while threads run
print("waiting for notifications...")
print("from a:", a.receive())
print("from b:", b.receive())

// wait for threads to finish
let ra = await a
let rb = await b

// string interpolation
print("Nico: ${ra} | Rio: ${rb} | Total: ${household}")

