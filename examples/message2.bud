def worker:
    send("hi")
    send("okay")
    send("bye")
    sleep_ms(300)

let child = spawn worker()

while(!child.done()): // can use this instead of await 
    if(child.pending() > 0): // can also use .canReceive, both of these also work in child (without the dot)
        print(child.receive())

print("All done")