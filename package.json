  },
  "dependencies": {
    "chevrotain": "^12.0.0",
    "cli-spinners": "^3.4.0",
    "ora": "^9.4.0",
    "ts-command-line-args": "^2.5.1"
  },
  "bin": {
    "bud": "dist/cli.js"
  }
