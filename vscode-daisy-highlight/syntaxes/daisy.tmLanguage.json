{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Daisy",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.daisy",
          "match": "//.*$"
        },
        {
          "name": "comment.block.daisy",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.daisy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.daisy",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.daisy",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.daisy",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.daisy",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.daisy",
          "match": "\\b(if|elif|else|while|for|break|return|function|end|let|spawn|await|match|shared|cpp|include)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.daisy",
          "match": "\\b(None|bool|int|string|float|list|dict|Integer|String|Float|Handler)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.daisy",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.daisy",
          "match": "(->|==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%|&&|\\|\\|)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.daisy",
          "match": "\\b(send|receive|print)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.daisy",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.daisy",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.daisy",
          "match": "[\\{\\}\\[\\]().,;:]"
        }
      ]
    }
  },
  "scopeName": "source.daisy"
}
