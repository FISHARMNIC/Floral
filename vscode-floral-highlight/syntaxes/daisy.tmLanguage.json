{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Floral",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.floral",
          "match": "//.*$"
        },
        {
          "name": "comment.block.floral",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.floral",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.floral",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.floral",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.floral",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.floral",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.floral",
          "match": "\\b(if|elif|else|while|for|break|return|function|def|end|let|spawn|await|match|shared|cpp|include|lam|lambda|const)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "comment": "Shared generic type $List<Integer>",
          "match": "(\\$)([A-Z][a-zA-Z0-9_]*)(<)([A-Z][a-zA-Z0-9_]*)(>)",
          "captures": {
            "1": { "name": "storage.modifier.shared.floral" },
            "2": { "name": "support.type.floral" },
            "3": { "name": "punctuation.floral" },
            "4": { "name": "support.type.floral" },
            "5": { "name": "punctuation.floral" }
          }
        },
        {
          "comment": "Generic type List<Integer>",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)(<)([A-Z][a-zA-Z0-9_]*)(>)",
          "captures": {
            "1": { "name": "support.type.floral" },
            "2": { "name": "punctuation.floral" },
            "3": { "name": "support.type.floral" },
            "4": { "name": "punctuation.floral" }
          }
        },
        {
          "comment": "Shared type prefix $Type — $ gets storage.type color, TypeName gets type color",
          "match": "(\\$)(Integer|Int|String|Float|Boolean|Handler|[A-Z][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.shared.floral" },
            "2": { "name": "support.type.floral" }
          }
        },
        {
          "name": "support.type.floral",
          "match": "\\b(None|Boolean|Integer|Int|String|Float|Handler)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.floral",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.floral",
          "match": "(->|==|!=|<=|>=|<|>|=|\\+|-|\\*|/|%|&&|\\|\\||!(?!=))"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.floral",
          "match": "\\b(send|receive|print)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.floral",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*(?=\\()"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.floral",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.floral",
          "match": "[\\{\\}\\[\\]().,;:]"
        }
      ]
    }
  },
  "scopeName": "source.floral"
}
