{
  "name": "floral-highlight",
  "displayName": "Floral Language Highlight",
  "description": "Syntax highlighting for the Floral programming language",
  "version": "0.2.4",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "floral",
        "aliases": [
          "Floral",
          "floral"
        ],
        "extensions": [
          ".bud"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "floral",
        "scopeName": "source.floral",
        "path": "./syntaxes/daisy.tmLanguage.json"
      }
    ]
  },
  "author": "Floral Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/floral"
  }
}
