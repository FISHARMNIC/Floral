{
  "name": "floral-highlight",
  "displayName": "Floral Language Highlight",
  "description": "Syntax highlighting for the Floral programming language",
  "version": "0.2.5",
  "main": "./extension.js",
  "engines": {
    "vscode": "^1.50.0"
  },
  "activationEvents": [
    "onLanguage:floral",
    "workspaceContains:**/*.bconfig"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "floral.runFile",
        "title": "Run Floral File",
        "icon": "$(play)",
        "category": "Floral"
      },
      {
        "command": "floral.runScript",
        "title": "Run Script",
        "icon": "$(play)",
        "category": "Floral"
      },
      {
        "command": "floral.refreshScripts",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Floral"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "floralScripts",
          "name": "Bud Scripts"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "floral.runFile",
          "when": "resourceLangId == floral",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "floral.refreshScripts",
          "when": "view == floralScripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "floral.runScript",
          "when": "view == floralScripts && viewItem == floralScript",
          "group": "inline"
        }
      ]
    },
    "languages": [
      {
        "id": "floral",
        "aliases": [
          "Floral",
          "floral"
        ],
        "extensions": [
          ".bud"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json",
        "extensions": [
          ".bconfig"
        ]
      }
    ],
    "grammars": [
      {
        "language": "floral",
        "scopeName": "source.floral",
        "path": "./syntaxes/daisy.tmLanguage.json"
      }
    ]
  },
  "author": "Floral Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/floral"
  }
}
